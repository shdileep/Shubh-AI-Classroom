# GapFinder AI - Environment Configuration Example
# Copy this file to backend/.env and replace the placeholders with your actual keys.

# Database Configuration (PostgreSQL or fallback SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gapfinder_db

# Security & JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here
PORT=8000

# Clerk Authentication (Google OAuth & User Management)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Transactional Email & OTP Service
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=GapFinder AI <onboarding@resend.dev>

# Optional: LLM Generation
OPENAI_API_KEY=
