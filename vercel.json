{
  "version": 2,
  "buildCommand": "cd gapfinder-app && npm install && npm run build",
  "outputDirectory": "gapfinder-app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
